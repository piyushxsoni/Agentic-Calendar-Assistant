# ---- Server ----
PORT=4000
APP_URL=http://localhost:3000            # frontend origin (CORS + OAuth return)
SERVER_URL=http://localhost:4000         # public URL of this backend (MCP only)

# ---- PostgreSQL (matches docker-compose.yml: host port 5442) ----
DATABASE_URL=postgresql://postgres:<password>@localhost:5442/agentic_calendar_app_db

# ---- Descope (server-side; NEVER expose to browser) ----
DESCOPE_PROJECT_ID=                      # Console > Project > Settings; must equal NEXT_PUBLIC_DESCOPE_PROJECT_ID
DESCOPE_MANAGEMENT_KEY=                  # Console > Company > Management Keys (needed to fetch outbound tokens)
DESCOPE_CALENDAR_CONNECTION_ID=google-calendar   # must equal the Outbound App ID in Descope
# DESCOPE_CALENDAR_SCOPES=https://www.googleapis.com/auth/calendar.events https://www.googleapis.com/auth/calendar.freebusy

# ---- AI provider (Gemini by default; any ONE of these keys works) ----
GEMINI_API_KEY=                          # https://aistudio.google.com/apikey
AI_MODEL=gemini-2.5-flash
# OPENAI_API_KEY=                        # only if you want OpenAI instead (set AI_MODEL e.g. gpt-4o-mini, leave Gemini keys empty)

# ---- Optional MCP (leave empty to disable) ----
DESCOPE_MCP_SERVER_WELL_KNOWN_URL=
